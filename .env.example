# OpenSigWeave standalone Docker configuration
# Copy this file to .env and replace all required placeholders before starting.
# Generate independent secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# PostgreSQL container
POSTGRES_DB="opensigweave"
POSTGRES_USER="opensigweave"
POSTGRES_PASSWORD="REPLACE_WITH_RANDOM_POSTGRES_PASSWORD"
# Compose overrides DATABASE_URL to use the internal PostgreSQL service name.
DATABASE_URL="postgresql+psycopg://opensigweave:REPLACE_WITH_RANDOM_POSTGRES_PASSWORD@postgres:5432/opensigweave"
SIGNATURE_STORAGE_PATH="/data/signatures"

# Application network binding. Keep loopback for a same-host proxy.
# For a separate proxy host, set this to the application server private interface IP,
# then allow TCP/8085 through the host firewall from the proxy IP only.
APP_BIND_ADDRESS="127.0.0.1"
# Host port maps to container port 8085. Change only with firewall and proxy review.
APP_PORT="8085"

# Required application secrets. Use different generated values.
SECRET_KEY="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
ENGINE_API_KEY="REPLACE_WITH_A_SEPARATE_RANDOM_ENGINE_KEY"
# Optional: enable unattended administrator REST access with a third, independent random secret.
# Leave empty to disable API-key-based management completely.
MANAGEMENT_API_KEY=""

# Optional Stalwart MTA-hook authentication. Required only when enabling the Stalwart adapter.
STALWART_HOOK_TOKEN=""

# External providers (Authentik OIDC, generic OIDC and LDAP) are configured in the administrator portal.
# OIDC callback URIs use https://<portal-host>/auth/<provider-id>.
# Additional explicit hostnames, comma-separated. Required for all installations; no wildcards.
APP_ALLOWED_HOSTS=""

# Generate the password hash with: python scripts/hash_password.py
LOCAL_ADMIN_EMAIL="admin@example.com"
LOCAL_ADMIN_PASSWORD_HASH=""

# Employee attribute providers are configured in the administrator portal.
# Credentials are persisted in /app/.idp/<provider-id>/.env on the opensigweave-idp-data volume.

# Shared database-backed request limits.
LOGIN_RATE_LIMIT="10"
AUTH_CALLBACK_RATE_LIMIT="20"
ENGINE_RATE_LIMIT="1800"
# Only configure trusted proxy CIDRs when the immediate proxy peer is known.
TRUSTED_PROXY_CIDRS=""

# Backup Locations: dedicated encryption key for SMB passwords in PostgreSQL.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key in protected configuration and offline recovery storage; never
# rotate it without re-encrypting stored SMB passwords.
BACKUP_LOCATIONS_KEY=""
# Local targets reside beneath this persistent Docker volume directory.
BACKUP_LOCAL_ROOT="/app/backups"

# Native, host-independent Backup Rules / pre-update backups.
# Encrypt with an off-host-escrowed age recipient and VERIFY by decrypting
# with its corresponding recovery identity. Set exactly one identity source.
# Generate an age key with: age-keygen
BACKUP_AGE_RECIPIENT=""
# Inline form lives in protected .env (0600) and is never included in archives.
BACKUP_AGE_IDENTITY=""
# Alternative: read a private 0600 file mounted inside the application.
BACKUP_AGE_IDENTITY_FILE=""
BACKUP_RULE_SCHEDULER_ENABLED="true"
# Plaintext staging is temporary in the persistent backups volume (0700).
BACKUP_WORK_ROOT="/app/backups"
