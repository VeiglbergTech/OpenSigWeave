# OpenSigWeave standalone Docker configuration
# Copy this file to .env and replace placeholders for the selected authentication mode before starting.
# Generate independent secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# PostgreSQL container
POSTGRES_DB="opensigweave"
POSTGRES_USER="opensigweave"
POSTGRES_PASSWORD="REPLACE_WITH_RANDOM_POSTGRES_PASSWORD"
# Compose overrides DATABASE_URL to use the internal PostgreSQL service name.
DATABASE_URL="postgresql+psycopg://opensigweave:REPLACE_WITH_RANDOM_POSTGRES_PASSWORD@postgres:5432/opensigweave"
SIGNATURE_STORAGE_PATH="/data/signatures"

# Required application secrets. Use different generated values.
SECRET_KEY="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
ENGINE_API_KEY="REPLACE_WITH_A_SEPARATE_RANDOM_ENGINE_KEY"

# Authentication mode. true keeps the existing Authentik/OIDC login; false enables local admin login.
OIDC_ENABLED="true"

# OIDC login. Required only when OIDC_ENABLED=true. The redirect URI must exactly match the provider.
# UserInfo must return email_verified=true (boolean) and groups as an array of group names.
# The default profile mapping provides groups; the custom opensigweave mapping provides
# email_verified and the attributes object (phone/title). See the README for setup.
OIDC_DISCOVERY_URL="https://auth.yourdomain.com/application/o/opensigweave/.well-known/openid-configuration"
OIDC_REDIRECT_URI="https://signature.yourdomain.com/auth"
OIDC_CLIENT_ID="your_oidc_client_id"
OIDC_CLIENT_SECRET="your_oidc_client_secret"
OIDC_SCOPES="openid email profile opensigweave"
# Additional explicit hostnames, comma-separated. Required in local-only mode; no wildcards.
APP_ALLOWED_HOSTS=""

# Local administrator login. Required only when OIDC_ENABLED=false.
# Generate the password hash with: python scripts/hash_password.py
LOCAL_ADMIN_EMAIL="admin@example.com"
LOCAL_ADMIN_PASSWORD_HASH=""

# Identity attribute source is independent of the login method: authentik, ldap or none.
# Defaults to authentik when OIDC is enabled and none for local-only login.
IDENTITY_PROVIDER="authentik"

# Authentik employee-attribute lookup. Use a read-only service account/API token.
# Use a dedicated service account/API token with read-only access to user records.
AUTHENTIK_URL="https://auth.yourdomain.com"
AUTHENTIK_SLUG="opensigweave"
AUTHENTIK_API_TOKEN="your_authentik_read_only_service_account_token"

# Direct LDAP / Active Directory lookup (choose IDENTITY_PROVIDER="ldap").
# LDAPS with a publicly trusted or container-trusted certificate is mandatory.
LDAP_URL="ldaps://dc01.example.org:636"
LDAP_BIND_DN="CN=OpenSigWeave Reader,OU=Service Accounts,DC=example,DC=org"
LDAP_BIND_PASSWORD="replace_with_read_only_bind_password"
LDAP_BASE_DN="DC=example,DC=org"
# AD default: match the exact mail attribute. Escape sequences are applied to the email value.
LDAP_USER_FILTER="(&(objectCategory=person)(objectClass=user)(mail={email}))"
LDAP_TIMEOUT="5"

# Shared database-backed request limits.
LOGIN_RATE_LIMIT="10"
AUTH_CALLBACK_RATE_LIMIT="20"
ENGINE_RATE_LIMIT="1800"
# Only configure trusted proxy CIDRs when the immediate proxy peer is known.
TRUSTED_PROXY_CIDRS=""
