# OpenSigWeave standalone Docker configuration
# Copy this file to .env and replace every placeholder before starting.
# Generate independent secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# PostgreSQL container
POSTGRES_DB="opensigweave"
POSTGRES_USER="opensigweave"
POSTGRES_PASSWORD="REPLACE_WITH_RANDOM_POSTGRES_PASSWORD"
# Compose overrides DATABASE_URL to use the internal PostgreSQL service name.
DATABASE_URL="postgresql+psycopg://opensigweave:REPLACE_WITH_RANDOM_POSTGRES_PASSWORD@postgres:5432/opensigweave"
SIGNATURE_STORAGE_PATH="/data/signatures"

# Required application secrets. Use different generated values.
SECRET_KEY="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
ENGINE_API_KEY="REPLACE_WITH_A_SEPARATE_RANDOM_ENGINE_KEY"

# OIDC login. The redirect URI must exactly match the identity provider registration.
OIDC_DISCOVERY_URL="https://auth.yourdomain.com/application/o/opensigweave/.well-known/openid-configuration"
OIDC_REDIRECT_URI="https://signature.yourdomain.com/auth"
OIDC_CLIENT_ID="your_oidc_client_id"
OIDC_CLIENT_SECRET="your_oidc_client_secret"
OIDC_SCOPES="openid email profile attributes"
# Additional explicit reverse-proxy hostnames, comma-separated. No wildcards.
APP_ALLOWED_HOSTS=""

# Authentik is the first supported profile-attribute provider for this MVP.
AUTHENTIK_URL="https://auth.yourdomain.com"
AUTHENTIK_SLUG="opensigweave"
AUTHENTIK_API_TOKEN="your_authentik_service_account_token"

# Shared database-backed request limits.
LOGIN_RATE_LIMIT="10"
AUTH_CALLBACK_RATE_LIMIT="20"
ENGINE_RATE_LIMIT="1800"
# Only configure trusted proxy CIDRs when the immediate proxy peer is known.
TRUSTED_PROXY_CIDRS=""
