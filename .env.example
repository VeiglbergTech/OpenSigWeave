# OpenSigWeave environment template
# Copy to .env and replace every placeholder before starting the application.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# PostgreSQL is the recommended new-install database.
# Generate POSTGRES_PASSWORD with the same secrets command used for SECRET_KEY.
POSTGRES_DB="opensigweave"
POSTGRES_USER="opensigweave"
POSTGRES_PASSWORD="REPLACE_WITH_RANDOM_POSTGRES_PASSWORD"
DATABASE_URL="postgresql+psycopg://opensigweave:REPLACE_WITH_RANDOM_POSTGRES_PASSWORD@127.0.0.1:5432/opensigweave"
# For a legacy SQLite installation, use: sqlite:///./opensigweave.db
SIGNATURE_STORAGE_PATH="./signatures"

# Required: at least 32 characters, generated randomly. The application refuses
# to start with an empty, short or known placeholder value.
SECRET_KEY="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Standard OIDC client configuration. For Authentik, use the provider's
# discovery URL ending in /.well-known/openid-configuration.
OIDC_DISCOVERY_URL="https://auth.yourdomain.com/application/o/opensigweave/.well-known/openid-configuration"
# Must exactly match the redirect URI registered at the identity provider.
# Do not derive this from the incoming HTTP Host header.
OIDC_REDIRECT_URI="https://signature.yourdomain.com/auth"
OIDC_CLIENT_ID="your_oidc_client_id"
OIDC_CLIENT_SECRET="your_oidc_client_secret"
OIDC_SCOPES="openid email profile attributes"

# Authentik remains the current employee-attribute source and logout endpoint.
AUTHENTIK_URL="https://auth.yourdomain.com"
AUTHENTIK_SLUG="opensigweave"
AUTHENTIK_API_TOKEN="your_authentik_service_account_token"

# Configure a new, unique key after rotating any key previously embedded in
# rspamd/opensigweave.lua. Keep this value outside source control.
ENGINE_API_KEY="REPLACE_WITH_A_SEPARATE_RANDOM_ENGINE_KEY"
