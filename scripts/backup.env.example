# Copy to /etc/opensigweave/backup.env and protect with chmod 0600.
# The backup directory must be a dedicated NFS, SMB, or other remote mount.
PROJECT_DIR=/opt/opensigweave
BACKUP_DIRECTORY=/mnt/opensigweave-backups
AGE_RECIPIENT=REPLACE_WITH_AGE_RECIPIENT
AGE_IDENTITY=/etc/opensigweave/age-identity.txt
RETENTION_COUNT=14
DOCKER_BINARY=docker
AGE_BINARY=age
PYTHON_BINARY=python3
