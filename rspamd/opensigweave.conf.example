# Example Rspamd configuration section.
# Merge this section into rspamd.conf.local (do not commit a real key).
opensigweave {
    api_url = "https://signature.example.org/api/signature/";
    engine_api_key = "REPLACE_WITH_THE_SAME_RANDOM_ENGINE_API_KEY_AS_BACKEND";
    timeout = 5.0;
    max_response_size = 65536;
    max_response_size = 65536;
}
