# Example Rspamd configuration section.
# Merge this section into rspamd.conf.local (do not commit a real key).
opensigweave {
    api_url = "https://signature.example.org/api/v1/engine/signatures/";
    engine_api_key = "REPLACE_WITH_THE_SAME_RANDOM_ENGINE_API_KEY_AS_BACKEND";
    timeout = 5.0;
    # CID engine responses include base64 inline images; 64 KiB is insufficient.
    max_response_size = 6291456;
    # Existing installations default to disabled; enabled requests 4xx on technical errors.
    failure_policy = "disabled";
    # Opt in to domain-aware offline decisions. The JSON snapshot must be
    # installed under Mailcow's mounted data/conf/rspamd/local.d directory.
    # A trusted v2 snapshot remains usable after long outages.
    # Missing/malformed snapshots and unknown domains still temporarily reject.
    # Host emergency override, exact domains only:
    # domain_policy_force_required = ["critical.example.org"];
    domain_policy_file = "/etc/rspamd/local.d/opensigweave-domain-policy.json";
    # Enable CID for managed signature images; install opensigweave_cid.lua.
    # Existing deployments without this setting still use external links.
    inline_images = "cid";
}
